# Get a key at https://musiclink.one/dashboard. Server-only: never prefix with VITE_.
MUSICLINK_API_KEY=
# Needed for new Qobuz input links: an application key issued by Qobuz.
# MusicLink supports Qobuz as an output but currently rejects Qobuz input URLs.
QOBUZ_APP_ID=
# Optional: defaults to 5173 in development, 3000 in production.
# PORT=5173
# HOST=127.0.0.1
